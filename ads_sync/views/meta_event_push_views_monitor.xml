    <!-- Monitor Action - Read-only monitoring interface -->
    <record id="action_meta_event_push_monitor" model="ir.actions.act_window">
        <field name="name">Monitor Pushed Events</field>
        <field name="res_model">ads.meta.event.push</field>
        <field name="view_mode">list,form</field>
        <!-- <field name="search_view_id" ref="view_meta_event_push_monitor_search"/> -->
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No events have been pushed yet
            </p>
            <p>
                Monitor all events pushed to Meta/GGAds APIs. Track their status, responses, and any errors.
            </p>
        </field>
    </record>

</odoo>