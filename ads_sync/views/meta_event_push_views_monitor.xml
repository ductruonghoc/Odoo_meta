<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Meta Event Push Monitor Views -->

    <!-- Monitor List View - Focused on tracking and monitoring -->
    <record id="view_meta_event_push_monitor_list" model="ir.ui.view">
        <field name="name">ads.meta.event.push.monitor.list</field>
        <field name="model">ads.meta.event.push</field>
        <field name="arch" type="xml">
            <list string="Event Push Monitor" default_order="sent_at desc, create_date desc"
                  decoration-success="state == 'success'"
                  decoration-warning="state == 'sent'"
                  decoration-danger="state == 'error'"
                  decoration-muted="state == 'draft'">
                <field name="sent_at"/>
                <field name="name"/>
                <field name="template"/>
                <field name="subscription_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'success'"
                       decoration-warning="state == 'sent'"
                       decoration-danger="state == 'error'"
                       decoration-info="state == 'draft'"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Monitor Form View - Read-only monitoring interface -->
    <record id="view_meta_event_push_monitor_form" model="ir.ui.view">
        <field name="name">ads.meta.event.push.monitor.form</field>
        <field name="model">ads.meta.event.push</field>
        <field name="arch" type="xml">
            <form string="Event Push Monitor" create="false" edit="false">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,success,error"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Event Details">
                            <field name="template" readonly="1"/>
                            <field name="subscription_id" readonly="1"/>
                            <field name="pixel_id_override" readonly="1"/>
                            <field name="access_token_override" readonly="1"/>
                        </group>
                        <group string="Timestamps">
                            <field name="create_date" readonly="1"/>
                            <field name="sent_at" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payload (Formatted)" name="payload_formatted">
                            <field name="payload_formatted" readonly="1" nolabel="1"
                                   widget="ace" options="{'mode': 'json'}"/>
                        </page>
                        <page string="Raw Payload" name="payload_raw">
                            <field name="payload_json" readonly="1" nolabel="1"/>
                        </page>
                        <page string="API Response" name="response" invisible="not response_json">
                            <field name="response_json" readonly="1" nolabel="1"
                                   widget="ace" options="{'mode': 'json'}"/>
                        </page>
                        <page string="Error Details" name="error" invisible="not error_message">
                            <div class="alert alert-danger" role="alert">
                                <strong>Error:</strong>
                                <field name="error_message" readonly="1" nolabel="1"/>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

