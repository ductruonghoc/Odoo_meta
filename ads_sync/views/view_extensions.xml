<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- CRM Lead/Opportunity Form View - Header Placement -->
    <record id="view_crm_lead_form_meta_event" model="ir.ui.view">
        <field name="name">crm.lead.form.meta.event</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <!-- Add to the header for easy access -->
            <xpath expr="//header" position="inside">
                <div class="ms-auto d-flex align-items-center" groups="base.group_system">
                    <label for="meta_event_enabled" class="me-2 mb-0" string="Meta Tracking"/>
                    <field name="meta_event_enabled" 
                           widget="boolean_toggle" 
                           nolabel="1"/>
                </div>
            </xpath>
        </field>
    </record>

