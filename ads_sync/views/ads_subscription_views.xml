    <!-- Kanban View -->
    <record id="view_ads_subscription_kanban" model="ir.ui.view">
        <field name="name">ads.subscription.kanban</field>
        <field name="model">ads.subscription</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="name"/>
                <field name="platform"/>
                <field name="state"/>
                <field name="subscription_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top mb8">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <field name="state" widget="badge" options="{'classes': {'draft': 'info', 'subscribed': 'success', 'error': 'danger', 'cancelled': 'secondary'}}"/>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="platform"/>
                                <t t-if="record.subscription_id.value">
                                    <br/><small class="text-muted"><field name="subscription_id"/></small>
                                </t>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action -->
    <record id="action_ads_subscription" model="ir.actions.act_window">
        <field name="name">Subscriptions</field>
        <field name="res_model">ads.subscription</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{'default_platform': 'meta'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Ads Subscription
            </p>
            <p>
                Subscribe to advertising platforms to sync conversion events and track your marketing performance.
            </p>
        </field>
    </record>

    <!-- Explicit View Mapping -->
    <record id="action_ads_subscription_view_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_ads_subscription_list"/>
        <field name="act_window_id" ref="action_ads_subscription"/>
    </record>
    <record id="action_ads_subscription_view_form" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_ads_subscription_form"/>
        <field name="act_window_id" ref="action_ads_subscription"/>
    </record>
    <record id="action_ads_subscription_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence">3</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_ads_subscription_kanban"/>
        <field name="act_window_id" ref="action_ads_subscription"/>
    </record>

</odoo>
