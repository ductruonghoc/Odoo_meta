<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="view_ads_subscription_form" model="ir.ui.view">
        <field name="name">ads.subscription.form</field>
        <field name="model">ads.subscription</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="Ads Subscription">
                <header>
                    <button name="action_subscribe_local" string="Subscribe (Local)" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_subscribe" string="Subscribe (API)" type="object" class="btn-secondary" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-danger" invisible="state not in ('subscribed',)"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state not in ('error', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,subscribed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_credentials" type="object" class="oe_stat_button" icon="fa-key" invisible="state != 'subscribed'">
                            <span>View Credentials</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Meta Main Pixel"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group string="Configuration">
                            <field name="platform"/>
                            <field name="api_endpoint" invisible="state == 'subscribed'"/>
                        </group>
                        <group string="Status" invisible="state == 'draft'">
                            <field name="subscription_id"/>
                            <field name="subscribed_at"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Meta Credentials" name="meta_credentials" invisible="platform != 'meta'">
                            <group>
                                <group string="Credentials">
                                    <field name="meta_access_token" password="True" placeholder="EAA..." readonly="state == 'subscribed'"/>
                                    <field name="meta_pixel_id" placeholder="1234..." readonly="state == 'subscribed'"/>
                                </group>
                                <group string="Callback URLs">
                                    <field name="callback_url" widget="url" placeholder="https://easter-unprofiteering-tristin.ngrok-free.dev/webhooks/meta" readonly="state == 'subscribed'" help="Enter your Odoo webhook URL - middleman will send events here"/>
                                    <field name="api_callback_url" widget="url" string="API Callback URL" help="Register this URL in Meta Events Manager"/>
                                </group>
                            </group>
                            <div class="alert alert-info" role="alert" invisible="state != 'draft'">
                                <strong>Setup Guide:</strong> Generate an Access Token from the Meta Events Manager.
                            </div>
                        </page>
                        <page string="Error Details" name="error_details" invisible="state != 'error'">
                            <field name="error_message" readonly="1" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <!-- <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div> -->
            </form>
        </field>
    </record>

    <!-- Credentials Popup Form -->
    <record id="view_ads_subscription_credentials_form" model="ir.ui.view">
        <field name="name">ads.subscription.credentials.form</field>
        <field name="model">ads.subscription</field>
        <field name="arch" type="xml">
            <form string="Subscription Credentials">
                <sheet>
                    <group>
                        <field name="subscription_id" readonly="1"/>
                        <field name="api_key" readonly="1"/>
                        <field name="webhook_verify_token" readonly="1"/>
                    </group>
                    <group string="Callback URLs">
                        <field name="callback_url" readonly="1" widget="url" string="Odoo Webhook URL"/>
                        <field name="api_callback_url" readonly="1" widget="url" string="API Callback URL"/>
                    </group>
                    <div class="alert alert-warning" role="alert">
                        <strong>Important:</strong> Keep these credentials secure. Do not share them publicly.
                    </div>
                </sheet>
                <footer>
                    <button string="Close" class="btn-primary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_ads_subscription_list" model="ir.ui.view">
        <field name="name">ads.subscription.list</field>
        <field name="model">ads.subscription</field>
        <field name="arch" type="xml">
            <list string="Ads Subscriptions" decoration-success="state == 'subscribed'" 
                  decoration-danger="state == 'error'" decoration-muted="state == 'cancelled'">
                <field name="is_active" widget="boolean_toggle" readonly="state != 'subscribed'"/>
                <field name="name"/>
                <field name="platform"/>
                <field name="api_key" password="True"/>
                <field name="api_callback_url" string="API Callback"/>
                <field name="subscribed_at"/>
                <field name="state" widget="badge" 
                       decoration-success="state == 'subscribed'"
                       decoration-info="state == 'draft'"
                       decoration-danger="state == 'error'"
                       decoration-muted="state == 'cancelled'"/>
                <button name="action_use_subscription" type="object" string="Use" class="btn-primary btn-sm" invisible="state != 'subscribed' or is_active"/>
            </list>
        </field>
    </record>

