<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="view_meta_webhook_event_form" model="ir.ui.view">
        <field name="name">ads.meta.webhook.event.form</field>
        <field name="model">ads.meta.webhook.event</field>
        <field name="arch" type="xml">
            <form string="Meta Webhook Event">
                <header>
                    <button name="action_mark_processed" string="Mark Processed" type="object" 
                            class="btn-primary" invisible="state in ('processed', 'ignored')"/>
                    <button name="action_mark_ignored" string="Mark Ignored" type="object" 
                            class="btn-secondary" invisible="state in ('processed', 'ignored')"/>
                    <button name="action_reprocess" string="Reprocess" type="object" 
                            invisible="state not in ('processed', 'error', 'ignored')"/>
                    <field name="state" widget="statusbar" statusbar_visible="received,processing,processed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Event Details">
                            <field name="event_type"/>
                            <field name="object_type"/>
                            <field name="entry_id"/>
                            <field name="received_at"/>
                        </group>
                        <group string="Source">
                            <field name="source_ip"/>
                            <field name="subscription_id"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Payload (Formatted)" name="payload_formatted">
                            <field name="payload_formatted" readonly="1" nolabel="1" 
                                   widget="ace" options="{'mode': 'json'}"/>
                        </page>
                        <page string="Raw Payload" name="payload_raw">
                            <field name="payload_json" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Processing Notes" name="notes" invisible="not processing_notes">
                            <field name="processing_notes" readonly="1" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_meta_webhook_event_list" model="ir.ui.view">
        <field name="name">ads.meta.webhook.event.list</field>
        <field name="model">ads.meta.webhook.event</field>
        <field name="arch" type="xml">
            <list string="Meta Webhook Events" default_order="received_at desc" 
                  decoration-success="state == 'processed'"
                  decoration-warning="state == 'processing'"
                  decoration-danger="state == 'error'"
                  decoration-muted="state == 'ignored'">
                <field name="received_at"/>
                <field name="event_type"/>
                <field name="object_type"/>
                <field name="entry_id"/>
                <field name="subscription_id"/>
                <field name="source_ip"/>
                <field name="state" widget="badge" 
                       decoration-success="state == 'processed'"
                       decoration-warning="state == 'processing'"
                       decoration-danger="state == 'error'"
                       decoration-info="state == 'received'"/>
            </list>
        </field>
    </record>

