    <!-- Action -->
    <record id="action_meta_event_push" model="ir.actions.act_window">
        <field name="name">Push Events</field>
        <field name="res_model">ads.meta.event.push</field>
        <field name="view_mode">list,form</field>
        <!-- <field name="search_view_id" ref="view_meta_event_push_search"/> -->
        <field name="context">{'search_default_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new event to push to Meta CAPI
            </p>
            <p>
                Use templates for common events like Purchase, Lead, Add to Cart, etc.
                Or write your own custom event payload.
            </p>
        </field>
