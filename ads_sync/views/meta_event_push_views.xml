<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="view_meta_event_push_form" model="ir.ui.view">
        <field name="name">ads.meta.event.push.form</field>
        <field name="model">ads.meta.event.push</field>
        <field name="arch" type="xml">
            <form string="Push Meta Event">
                <header>
                    <button name="action_push_event" string="🚀 Push Event" type="object" 
                            class="btn-primary" invisible="state not in ('draft', 'error')"/>
                    <button name="action_validate_json" string="✓ Validate JSON" type="object" 
                            class="btn-secondary" invisible="state not in ('draft', 'error')"/>
                    <button name="action_set_current_timestamp" string="⏱ Set Current Time" type="object" 
                            class="btn-secondary" invisible="state not in ('draft', 'error')"/>
                    <button name="action_reset_to_draft" string="↺ Reset" type="object" 
                            invisible="state == 'draft'"/>
                    <button name="action_duplicate_and_edit" string="📋 Duplicate" type="object" 
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,success"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Event Push Name"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group string="Event Configuration">
                            <field name="template" readonly="state != 'draft'"/>
                            <field name="subscription_id" readonly="state != 'draft'"/>
                        </group>
                        <group string="Optional Overrides">
                            <field name="pixel_id_override" placeholder="Leave empty to use subscription" 
                                   readonly="state != 'draft'"/>
                            <field name="access_token_override" password="True" 
                                   placeholder="Leave empty to use subscription" 
                                   readonly="state != 'draft'"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Event Payload" name="payload">
                            <div class="alert alert-info" role="alert" invisible="state != 'draft'">
                                <strong>💡 Tip:</strong> Select an event template above to auto-fill the payload, or write your own custom JSON.
                                <br/>Use "Set Current Time" to update event_time to now.
                            </div>
                            <field name="payload_json" readonly="state != 'draft'" 
                                   widget="ace" options="{'mode': 'json'}"
                                   placeholder='{"data": [{"event_name": "Purchase", ...}]}'/>
                        </page>
                        <page string="Response" name="response" invisible="not response_json">
                            <field name="response_json" readonly="1" widget="ace" options="{'mode': 'json'}"/>
                        </page>
                        <page string="Error" name="error" invisible="state != 'error'">
                            <div class="alert alert-danger" role="alert">
                                <field name="error_message" readonly="1" nolabel="1"/>
                            </div>
                        </page>
                    </notebook>
                    
                    <group string="Execution Details" invisible="state == 'draft'">
                        <field name="sent_at"/>
                    </group>
                </sheet>
                <!-- <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div> -->
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_meta_event_push_list" model="ir.ui.view">
        <field name="name">ads.meta.event.push.list</field>
        <field name="model">ads.meta.event.push</field>
        <field name="arch" type="xml">
            <list string="Meta Event Push" default_order="create_date desc"
                  decoration-success="state == 'success'"
                  decoration-warning="state == 'sent'"
                  decoration-danger="state == 'error'"
                  decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="template"/>
                <field name="subscription_id"/>
                <field name="sent_at"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'success'"
                       decoration-warning="state == 'sent'"
                       decoration-danger="state == 'error'"
                       decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

