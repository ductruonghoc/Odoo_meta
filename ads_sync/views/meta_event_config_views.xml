<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- list View with Grouping by Category -->
    <record id="view_meta_event_config_list" model="ir.ui.view">
        <field name="name">meta.event.config.list</field>
        <field name="model">meta.event.config</field>
        <field name="arch" type="xml">
            <list string="Meta Event Configurations" default_order="category, sequence">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="technical_name"/>
                <field name="category" invisible="1"/>
                <field name="trigger_description"/>
                <field name="is_active" widget="boolean_toggle"/>
                <field name="test_mode" widget="boolean_toggle"/>
                <field name="push_count"/>
                <field name="last_push_date"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_meta_event_config_form" model="ir.ui.view">
        <field name="name">meta.event.config.form</field>
        <field name="model">meta.event.config</field>
        <field name="arch" type="xml">
            <form string="Meta Event Configuration">
                <header>
                    <button name="action_toggle_active" type="object" 
                            string="Activate" class="btn-primary"
                            invisible="is_active"/>
                    <button name="action_toggle_active" type="object" 
                            string="Deactivate" class="btn-secondary"
                            invisible="not is_active"/>
                    <button name="action_test_push" type="object" 
                            string="Send Test Event" class="btn-warning"
                            invisible="not is_active"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_test_push"
                                icon="fa-paper-plane" invisible="not is_active">
                            <field name="push_count" widget="statinfo" string="Pushes"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Active" bg_color="bg-success" 
                            invisible="not is_active"/>
                    <widget name="web_ribbon" title="Inactive" bg_color="bg-secondary" 
                            invisible="is_active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Event Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Event Information">
                            <field name="technical_name"/>
                            <field name="category"/>
                            <field name="sequence"/>
                            <field name="description"/>
                        </group>
                        <group string="Trigger Configuration">
                            <field name="trigger_model"/>
                            <field name="trigger_action"/>
                            <field name="trigger_description"/>
                        </group>
                    </group>
                    <group>
                        <group string="Event Options">
                            <field name="is_active" widget="boolean_toggle"/>
                            <field name="test_mode" widget="boolean_toggle"/>
                            <field name="include_user_data"/>
                            <field name="include_custom_data"/>
                        </group>
                        <group string="Statistics">
                            <field name="push_count"/>
                            <field name="last_push_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Kanban View grouped by Category -->
    <record id="view_meta_event_config_kanban" model="ir.ui.view">
        <field name="name">meta.event.config.kanban</field>
        <field name="model">meta.event.config</field>
        <field name="arch" type="xml">
            <kanban default_group_by="category" class="o_kanban_mobile">
                <field name="name"/>
                <field name="technical_name"/>
                <field name="category"/>
                <field name="is_active"/>
                <field name="trigger_description"/>
                <field name="push_count"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click #{record.is_active.raw_value ? 'bg-success-light' : ''}">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top mb-2">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <field name="is_active" widget="boolean_toggle"/>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div class="text-muted small">
                                        <field name="trigger_description"/>
                                    </div>
                                    <div class="mt-2">
                                        <span class="badge badge-pill" 
                                              t-attf-class="#{record.is_active.raw_value ? 'badge-success' : 'badge-secondary'}">
                                            <t t-if="record.is_active.raw_value">Active</t>
                                            <t t-else="">Inactive</t>
                                        </span>
                                        <span class="badge badge-pill badge-info ml-1" t-if="record.push_count.raw_value > 0">
                                            <field name="push_count"/> pushes
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

