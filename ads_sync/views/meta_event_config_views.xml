    <!-- Action -->
    <record id="action_meta_event_config" model="ir.actions.act_window">
        <field name="name">Meta Event Configuration</field>
        <field name="res_model">meta.event.config</field>
        <field name="view_mode">list,kanban,form</field>
        <!-- <field name="search_view_id" ref="view_meta_event_config_search"/> -->
        <field name="context">{'search_default_group_category': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure Meta Conversion API Events
            </p>
            <p>
                Enable events to automatically push conversion data to Meta when specific actions occur in Odoo.
                This helps optimize your Meta Ads campaigns with real conversion data.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_meta_event_config"
              name="Event Configuration"
              parent="menu_ads_sync_root"
              action="action_meta_event_config"
              sequence="5"/>
</odoo>
