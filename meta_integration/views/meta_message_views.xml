<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Meta Message List View -->
    <record id="view_meta_message_list" model="ir.ui.view">
        <field name="name">meta.message.list</field>
        <field name="model">meta.message</field>
        <field name="arch" type="xml">
            <list string="Meta Incoming Messages">
                <field name="timestamp"/>
                <field name="message_id"/>
                <field name="sender_id"/>
                <field name="recipient_id"/>
                <field name="text"/>
                <field name="state" decoration-success="state == 'processed'" 
                       decoration-info="state == 'received'" 
                       decoration-danger="state == 'failed'" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Meta Message Form View -->
    <record id="view_meta_message_form" model="ir.ui.view">
        <field name="name">meta.message.form</field>
        <field name="model">meta.message</field>
        <field name="arch" type="xml">
            <form string="Meta Incoming Message">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="received,processed,failed"/>
                </header>
                <sheet>
                    <group>
                        <group string="Message Info">
                            <field name="message_id"/>
                            <field name="timestamp"/>
                            <field name="timestamp_raw"/>
                        </group>
                        <group string="Participants">
                            <field name="sender_id"/>
                            <field name="recipient_id"/>
                        </group>
                    </group>
                    <group string="Message Content">
                        <field name="text"/>
                    </group>
                    <group string="Commands">
                        <field name="commands"/>
                    </group>
                    <group string="Debug Info" groups="base.group_no_one">
                        <field name="raw_payload"/>
                        <field name="error_message"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Meta Message Search View -->
    <record id="view_meta_message_search" model="ir.ui.view">
        <field name="name">meta.message.search</field>
        <field name="model">meta.message</field>
        <field name="arch" type="xml">
            <search string="Search Messages">
                <field name="message_id"/>
                <field name="sender_id"/>
                <field name="recipient_id"/>
                <field name="text"/>
                <filter string="Received" name="filter_received" domain="[('state', '=', 'received')]"/>
                <filter string="Processed" name="filter_processed" domain="[('state', '=', 'processed')]"/>
                <filter string="Failed" name="filter_failed" domain="[('state', '=', 'failed')]"/>
            </search>
        </field>
    </record>

    <!-- Meta Message Action -->
    <record id="action_meta_message" model="ir.actions.act_window">
        <field name="name">Incoming Messages</field>
        <field name="res_model">meta.message</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_meta_message_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No incoming messages yet
            </p>
            <p>
                Messages received from Meta webhook will appear here.
            </p>
        </field>
    </record>
</odoo>
