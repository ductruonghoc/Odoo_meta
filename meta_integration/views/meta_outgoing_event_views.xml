<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Meta Outgoing Event List View -->
    <record id="view_meta_outgoing_event_list" model="ir.ui.view">
        <field name="name">meta.outgoing.event.list</field>
        <field name="model">meta.outgoing.event</field>
        <field name="arch" type="xml">
            <list string="Meta Outgoing Events">
                <field name="event_time"/>
                <field name="name"/>
                <field name="sale_order_id" optional="show"/>
                <field name="partner_id"/>
                <field name="value"/>
                <field name="currency"/>
                <field name="response_status"/>
                <field name="state" decoration-success="state == 'success'" 
                       decoration-info="state == 'sent'" 
                       decoration-warning="state == 'pending'"
                       decoration-danger="state == 'failed'" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Meta Outgoing Event Form View - Simplified JSON View -->
    <record id="view_meta_outgoing_event_form" model="ir.ui.view">
        <field name="name">meta.outgoing.event.form</field>
        <field name="model">meta.outgoing.event</field>
        <field name="arch" type="xml">
            <form string="Meta Outgoing Event">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="pending,sent,success,failed"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="event_time"/>
                        <field name="sale_order_id"/>
                        <field name="response_status"/>
                    </group>
                    <notebook>
                        <page string="Payload (JSON)" name="payload">
                            <field  name="payload" 
                                    widget="ace" 
                                    options="{'mode': 'javascript'}" 
                                    readonly="1"/>
                        </page>
                        <page string="Response" name="response">
                            <field name="response_body" widget="text" readonly="1" style="font-family: monospace; white-space: pre-wrap;"/>
                        </page>
                        <page string="Error" name="error">
                            <field name="error_message" widget="text" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

