    <!-- Meta Outgoing Event Action -->
    <record id="action_meta_outgoing_event" model="ir.actions.act_window">
        <field name="name">Outgoing Events</field>
        <field name="res_model">meta.outgoing.event</field>
        <field name="view_mode">list,form</field>
        <!-- <field name="search_view_id" ref="view_meta_outgoing_event_search"/> -->
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No outgoing events yet
            </p>
            <p>
                Events sent to Meta CAPI (like Purchase events from confirmed orders) will appear here.
            </p>
        </field>
    </record>
